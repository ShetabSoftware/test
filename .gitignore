# Octave/MATLAB session state
octave-workspace
*.asv
*.mat
slprj/

# Generated RTL co-simulation vectors
vectors/
*.mem

# GHDL / simulation build products.  The golden vectors under build/gold
# are regenerated by rtl/sim/run_sim.sh from the model, so they are
# derived artefacts and not sources - checking them in would let them
# drift from the model that produced them.
build/
work-obj*.cf
*.ghw
*.vcd

# Vivado tool residue.  Project outputs land under build/ (already ignored).
# The vivado/ directory holds source TCL scripts and is tracked.
*.jou
*.log
.Xil/
